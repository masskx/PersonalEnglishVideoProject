{
  "schemaVersion": 1,
  "authority": "AGENTS.md",
  "currentProductionBaseline": "docs/当前制作基准.md",
  "baselineScope": "all_english_video_columns",
  "currentAcceptedSample": "outputs/ten-tain/ten-tain.mp4",
  "visualReferenceSample": "references/visual-baseline/mit-miss-sunburst-full/mit-miss-sunburst-full.mp4",
  "deprecatedProductionRules": [
    "seedream_or_jimeng_as_default_image_generation",
    "svg_or_code_geometry_as_primary_illustration",
    "repeated_ppt_like_card_template",
    "perpetual_drift_or_random_bounce_motion",
    "midpoint_stills_without_whole_video_preview",
    "separate_low_spec_cet_visual_pipeline",
    "wan_image_to_video_dynamic_xiaohei"
  ],
  "startupGuide": "docs/新会话制作入口.md",
  "productionRouterSkill": ".agents/skills/make-xiaohei-english-video/SKILL.md",
  "requestDecision": {
    "concreteTopic": "follow_user_topic_and_preserve_old_versions",
    "columnOnly": "autonomously_select_unused_topic_and_complete_production",
    "discussionOrAudit": "do_not_start_video_production"
  },
  "defaultChain": [
    "classify_column",
    "cross_check_topic_history_and_actual_artifacts",
    "register_in_progress",
    "verify_sources",
    "write_natural_spoken_script",
    "preflight_per_word_visual_meaning_and_summary_coverage",
    "produce_narration",
    "build_xiaohei_semantic_key_poses",
    "review_contact_sheet_on_white_and_run_visual_coverage_gate",
    "apply_frame_driven_typography",
    "stage_only_referenced_public_assets_then_render_full_video",
    "build_full_video_preview_and_pass_layout_gate",
    "render_two_covers_and_publish_copy",
    "render_vertical_full_version",
    "run_media_and_content_review",
    "update_ledger_logs_and_workbench"
  ],
  "visualBaseline": {
    "method": "same_anchor_reference_edit_before_change_result",
    "reference": "assets/visual-baselines/mit-miss-sunburst/README.md",
    "reviewVideo": "references/visual-baseline/mit-miss-sunburst-full/mit-miss-sunburst-full.mp4",
    "fullCanvasSvgOverlay": false,
    "xiaoheiRequired": true,
    "paperCanvas": "src/replica/theme.ts paperStyle()：#FFFBF3 + #EDE4D3 点阵；浅蓝插图底板 #EAF0FF；词根荧光 #FFE36E；2026-10-14 起取代纯白画布",
    "smoothFrameDrivenTypography": true
  },
  "douyinPacing": {
    "targetFeel": "slightly_fast_bright_forward_motion",
    "hookBeatBySeconds": 1.5,
    "secondVisualTurnBySeconds": 3,
    "avoidRepeatedCardLayouts": true,
    "majorTeachingBeatUsesSemanticImage": true,
    "maxVisualHoldSeconds": 8,
    "maxShareOfHoldsOver3_5Seconds": 0.2,
    "gate": "src/replica/pacing.ts（replica:validate 与 project:test 执行；字幕换句不算画面变化）",
    "rootWordRenderer": "continuous + buildContinuousStage(storyboard, cover)；新期复制 src/replica/projects/cludClus.ts"
  },
  "visualImpact": {
    "wordPageSafeWidthOccupancyPercent": [78, 84],
    "semanticActorScaleVsLegacy": [1.25, 1.45],
    "minimumIntentionalCompositionsPerEpisode": 3,
    "generateMultipleAnchorCandidatesForMajorBeats": true,
    "supportScenesNeedMeaningfulVisualChanges": true,
    "banPptLikeRepeatedTextImageCards": true
  },
  "visualStyleContract": {
    "imageGeneration": "built_in_image_gen_raster",
    "referenceAnchor": "mit-miss",
    "canvas": "pure_white_1920x1080",
    "character": "solid_black_xiaohei_white_dot_eyes_wobbly_ink",
    "requiredPoseSequence": ["before", "change", "result"],
    "animation": ["smooth_rise_reveal_slide", "morpheme_assembly", "semantic_pose_cut", "white_fade"],
    "forbidden": ["svg_image_placeholder", "ppt_card_repeat", "perpetual_drift", "random_bounce"]
  },
  "finalPreviewGate": {
    "command": "npm run replica:full-preview -- --project=<slug>",
    "required": true,
    "intervalSeconds": 1,
    "includePlayablePreview": true,
    "checks": ["text_overflow", "safe_margins", "large_blank_area", "layout_balance", "scene_cuts", "phone_readability"],
    "evidence": "outputs/<slug>/review/full-preview/full-preview.mp4 + full-preview-contact-*.jpg + full-preview-report.json",
    "humanApprovalRequired": true
  },
  "coverSystem": {
    "template": "RootWordCover",
    "landscapeTemplate": "RootWordLandscapeCover",
    "portraitSize": [1080, 1440],
    "landscapeSize": [1200, 900],
    "allColumnsUseSharedRootCover": true,
    "requiredElements": ["blue rounded frame", "Xiaohei brand mark", "orange pill", "eyebrow", "primary title", "motion arrow", "hero illustration", "orange hook strip", "family pills", "series footer"]
  },
  "backgroundMusic": {
    "sourceLibrary": "assets/background-music/minimax",
    "runtimeMaster": "public/assets/music/root-word-series-bgm.mp3",
    "targetBpm": [104, 112],
    "instrumentalOnly": true,
    "memorableFourBarMotif": true,
    "phoneSpeakerAudibilityRequired": true,
      "defaultVolume": 0.08,
      "narrationDuckedVolume": 0.07,
    "mixPriority": "narration_first",
    "dynamicDuckingRequired": true,
    "listeningGate": "check_dense_chinese_and_english_on_phone_speaker"
  },
  "editorialVoice": {
    "naturalSpokenChinese": true,
    "preferConcreteSceneAndAction": true,
    "avoidFormulaicContrast": ["不是……而是……", "别再……", "先别……", "抓住……立刻……", "一个动作串起……"],
    "avoidGenericLearningClaims": true,
    "requireManualReadAloudPass": true
  },
  "wordVisualPreflight": {
    "planOnlyBeforeGeneration": "npm run replica:preflight -- --project=<slug> --plan-only",
    "fullAfterWhiteBackgroundReview": "npm run replica:preflight -- --project=<slug>",
    "requiredStates": ["before", "change", "result"],
    "oneUniqueSetPerTaughtWord": true,
    "summaryMustCoverAllTaughtWords": true,
    "failClosedOnRender": true,
    "runtimeAssetProvenanceRequired": true,
    "runtimeAssetDirectoryMustBeEpisodeLocal": true,
    "referenceReuseAllowedOnlyForGeneration": true,
    "failOnCrossEpisodeRuntimeSource": true,
    "assetProvenanceFields": ["assetDir", "generationMethod", "referenceAnchor", "runtimeSourceScan"]
  },
  "productionRouting": {
    "englishVideoRequestLoadsRouterSkill": ".agents/skills/make-xiaohei-english-video/SKILL.md",
    "columnSkills": {
      "rootWords": ".agents/skills/build-root-word-video/SKILL.md",
      "vocabulary": ".agents/skills/build-root-word-video/SKILL.md",
      "writingReadingTranslation": ".agents/skills/make-xiaohei-english-video/SKILL.md"
    },
    "neverSimplifyWithoutUserInstruction": true
  },
  "renderAssets": {
    "publicDirMode": "only-assets-referenced-by-current-project",
    "appliesTo": ["video", "cover", "review-stills"]
  },
  "verticalDelivery": {
    "since": "2026-10-12",
    "reason": "douyin_feed_is_vertical_landscape_fills_one_third_of_screen",
    "command": "npm run vertical:render -- --project=<slug>",
    "layoutCheck": "npm run vertical:stills -- --project=<slug>",
    "renderer": "src/replica/vertical/",
    "size": [1080, 1920],
    "outputs": ["vertical/<slug>-vertical.mp4", "vertical/<slug>-teaser.mp4", "vertical/review-card.png", "vertical/vertical-report.json"],
    "reusesLandscapeNarrationAndArt": true,
    "loopFriendlyEnding": true,
    "growthConfig": "planning/growth-promotion.json",
    "ownerGuideEnglish": "docs/growth-playbook-EN.md"
  },
  "shortsDelivery": {
    "since": "2026-10-14",
    "default": true,
    "note": "主推 30–40 秒竖屏短视频，抖音和小红书发同一条；一条视频一个文件夹，三张封面；钩子按 HOOK_ROTATION 轮换，不做 A/B。",
    "folder": "outputs/shorts/<id>/",
    "commands": ["npm run shorts:voice -- --short=<id> --generate --prune", "npm run shorts:render -- --short=<id>"],
    "video": [1080, 1920],
    "durationSeconds": [30, 40],
    "covers": {
      "cover-douyin-vertical.png": [1080, 1920],
      "cover-douyin-landscape.png": [1440, 1080],
      "cover-xiaohongshu.png": [1080, 1440]
    },
    "hookRotation": ["challenge", "mistake", "contrast", "result"],
    "maxDouyinTitleChars": 30,
    "maxXiaohongshuTitleChars": 20
  },
  "xiaohongshuDelivery": {
    "since": "2026-10-12",
    "retired": "2026-10-14",
    "retiredNote": "用户决定不再做小红书图文卡，小红书发同一条短视频。以下为旧配置，仅供追溯。",
    "reason": "owner_found_lecture_videos_unappealing_for_xiaohongshu_feed",
    "command": "npm run xhs:cards -- --project=<slug>",
    "size": [1080, 1440],
    "outputs": ["xiaohongshu/NN-*.png", "xiaohongshu/xhs-note.md", "xiaohongshu/contact-sheet.jpg"],
    "maxImages": 18,
    "maxTitleChars": 20,
    "config": "planning/growth-promotion.json#xiaohongshu"
  },
  "ownerCommunication": {
    "chatLanguage": "English",
    "repositoryLanguage": "Chinese",
    "note": "用户读英文、不读中文；对话用英文，仓库文档与画面文字保持中文。"
  },
  "delivery": {
    "minimumDefaultDurationSeconds": 120,
    "required": [
      "video",
      "coverPortrait",
      "coverLandscape",
      "verticalVideo",
      "publishCopy",
      "reviewEvidence",
      "topicLedgerUpdate",
      "workbenchRefresh"
    ],
    "autoPublish": false,
    "workbenchFirstScreen": "current_deliverables_only",
    "archiveDisplay": "collapsed_history_and_technical_evidence"
  }
}
