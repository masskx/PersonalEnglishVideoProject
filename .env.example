# 复制为 .env 后填写自己的值。.env 已被 .gitignore 忽略，永远不要提交。
# Copy to .env and fill in your own values. .env is gitignored; never commit it.
#
# 云端 Claude 会话不要用 .env：在环境设置里添加同名环境变量，并在 Network access 里允许对应域名。
# In Claude cloud sessions, add these as environment variables in the environment settings instead,
# and allow the matching domain under Network access. Run `npm run keys:check` to verify.

# 阿里云百炼（CosyVoice 配音、Wan 视频）  域名 dashscope.aliyuncs.com
DASHSCOPE_API_KEY=""

# OpenAI 兼容图片接口（gpt-image-2 或中转站）  域名 api.openai.com 或 OPENAI_BASE_URL 的域名
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_IMAGE_MODEL=""
OPENAI_IMAGE_EDIT_MODEL=""
REPLICA_IMAGE_PROVIDER=""

# 火山方舟 Seedream（历史路线，默认不用）  域名 ark.cn-beijing.volces.com
HUOSHAN_API_KEY=""
