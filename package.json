    "@remotion/studio": "^4.0.469",
    "@remotion/studio-server": "^4.0.469",
    "@remotion/studio-shared": "^4.0.469",
    "@remotion/timeline-utils": "^4.0.469",
    "@remotion/web-renderer": "^4.0.469",
    "@remotion/zod-types": "^4.0.469",
    "@rspack/binding": "^1.7.6",
    "@rspack/binding-win32-x64-msvc": "^1.7.6",
    "@rspack/core": "^1.7.6",
    "dotenv": "^16.4.7",
