    "replica:assets:verify": "tsx scripts/replica/verifyAssets.ts",
    "meme:vocab:generate": "tsx scripts/meme-vocab/generate.ts",
    "meme:vocab:tts": "tsx scripts/meme-vocab/generateTts.ts",
    "meme:vocab:qa": "tsx scripts/meme-vocab/qa.ts",
    "meme:vocab:render": "tsx scripts/meme-vocab/render.ts",
    "lint": "tsx scripts/meme-vocab/lint.ts",
    "test": "tsx scripts/meme-vocab/test.ts"
